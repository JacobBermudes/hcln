# ============================================================================
# CLEAN OFFICE — конфигурация Apache для российского шаблонного хостинга.
# Кладётся в корень сайта вместе с содержимым dist/.
# ============================================================================

# --- Один вариант домена: https, без www ------------------------------------
<IfModule mod_rewrite.c>
  RewriteEngine On

  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [R=301,L]

  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^(.*)$ https://%1/$1 [R=301,L]

  # Конечный слеш на всех страницах — так же, как отдаёт сборка
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_URI} !\.[a-zA-Z0-9]{2,5}$
  RewriteCond %{REQUEST_URI} !/$
  RewriteRule ^(.*)$ /$1/ [R=301,L]
</IfModule>

# --- 301 со старых адресов (карта из 05-seo-i-semantika.md) -----------------
<IfModule mod_rewrite.c>
  RewriteRule ^uborka-office/?$                                      /uslugi/uborka-ofisa/ [R=301,L]
  RewriteRule ^uborka-ofisov/?$                                      /uslugi/uborka-gostinic/ [R=301,L]
  RewriteRule ^uborka-magazinov/?$                                   /uslugi/uborka-magazina/ [R=301,L]
  RewriteRule ^uborka-torgovyix-czentrov-i-biznes-czentrov/?$        /uslugi/uborka-tc-i-bc/ [R=301,L]
  RewriteRule ^uborka-salonov-krasotyi/?$                            /uslugi/uborka-salonov-krasoty/ [R=301,L]
  RewriteRule ^uborka-skladov/?$                                     /uslugi/uborka-skladov/ [R=301,L]
  RewriteRule ^uborka-restoranov-i-kafe/?$                           /uslugi/uborka-restoranov/ [R=301,L]
  RewriteRule ^uborka-fitnes-centrov-i-sportivnyh-kompleksov/?$      /uslugi/uborka-fitnes-centrov/ [R=301,L]
  RewriteRule ^uborka-zhk-i-podezdov/?$                              /uslugi/uborka-zhk/ [R=301,L]
  RewriteRule ^myite-okon/?$                                         /uslugi/mojka-okon-i-fasadov/ [R=301,L]
  RewriteRule ^ximchistka-mebeli/?$                                  /uslugi/himchistka-mebeli/ [R=301,L]
  RewriteRule ^kontaktyi/?$                                          /kontakty/ [R=301,L]
  RewriteRule ^generalnaya-uborka/?$                                 /uslugi/uborka-ofisa/generalnaya/ [R=301,L]
  RewriteRule ^regulyarnaya-uborka/?$                                /uslugi/uborka-ofisa/regulyarnaya/ [R=301,L]
  RewriteRule ^posle-remonta/?$                                      /uslugi/uborka-ofisa/posle-remonta/ [R=301,L]
</IfModule>

# --- Сжатие ------------------------------------------------------------------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml
  AddOutputFilterByType DEFLATE application/javascript application/json
  AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

<IfModule mod_brotli.c>
  AddOutputFilterByType BROTLI_COMPRESS text/html text/css text/plain text/xml
  AddOutputFilterByType BROTLI_COMPRESS application/javascript application/json
  AddOutputFilterByType BROTLI_COMPRESS image/svg+xml
</IfModule>

# --- Кеширование статики -----------------------------------------------------
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html                 "access plus 0 seconds"
  ExpiresByType text/css                  "access plus 1 year"
  ExpiresByType application/javascript    "access plus 1 year"
  ExpiresByType image/webp                "access plus 1 year"
  ExpiresByType image/avif                "access plus 1 year"
  ExpiresByType image/jpeg                "access plus 1 year"
  ExpiresByType image/png                 "access plus 1 year"
  ExpiresByType image/svg+xml             "access plus 1 year"
  ExpiresByType font/woff2                "access plus 1 year"
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.(css|js|webp|avif|jpg|jpeg|png|svg|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.html$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>

  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
</IfModule>

# --- Типы --------------------------------------------------------------------
<IfModule mod_mime.c>
  AddType image/webp .webp
  AddType image/avif .avif
  AddType font/woff2 .woff2
</IfModule>

# --- Страница 404 ------------------------------------------------------------
ErrorDocument 404 /404.html
