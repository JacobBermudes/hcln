---
import Base from '../layouts/Base.astro';
import Button from '../components/ui/Button.astro';
import Icon from '../components/ui/Icon.astro';
import { services, serviceUrl } from '../data/services';
import { site } from '../data/site';
---

<Base
  title="Страница не найдена — CLEAN OFFICE"
  description="Такой страницы на сайте нет. Вернитесь на главную или выберите услугу."
  noindex
>
  <section class="nf section">
    <div class="container nf__inner">
      <p class="nf__code" aria-hidden="true">404</p>
      <h1 class="nf__title">Такой страницы нет</h1>
      <p class="nf__text">
        Возможно, адрес изменился при переезде сайта. Загляните в услуги или позвоните —
        подскажем за минуту.
      </p>

      <div class="nf__actions">
        <Button href="/" variant="primary">На главную</Button>
        <Button href={site.phoneHref} variant="ghost" icon="phone">{site.phone}</Button>
      </div>

      <ul class="nf__links">
        {services.slice(0, 6).map((s) => (
          <li>
            <a href={serviceUrl(s.slug)}>
              <Icon name={s.icon} size={20} />
              {s.menuTitle}
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>
</Base>

<style>
  .nf__inner {
    max-width: 44rem;
    text-align: center;
  }

  .nf__code {
    font-family: var(--font-display);
    font-size: clamp(4rem, 2rem + 9vw, 8rem);
    font-weight: 800;
    line-height: 1;
    letter-spacing: var(--tracking-tight);
    color: var(--blue-soft);
  }

  .nf__title {
    margin-top: var(--sp-4);
  }

  .nf__text {
    margin: var(--sp-4) auto 0;
    max-width: 44ch;
    font-size: var(--fs-lead);
    color: var(--ink-muted);
  }

  .nf__actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--sp-3);
    margin-top: var(--sp-7);
  }

  .nf__links {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--sp-2);
    margin-top: var(--sp-8);
    padding-top: var(--sp-6);
    border-top: 1px solid var(--line);
  }

  .nf__links a {
    display: inline-flex;
    align-items: center;
    gap: var(--sp-2);
    padding: var(--sp-3) var(--sp-4);
    border-radius: var(--r-pill);
    background: var(--surface);
    font-size: var(--fs-sm);
    font-weight: 600;
    transition: background-color var(--dur-hover) var(--ease-out);
  }

  .nf__links a:hover {
    background: var(--blue-soft);
  }

  .nf__links svg {
    color: var(--blue);
  }
</style>
