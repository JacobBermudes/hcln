---
import { geography } from '../../data/content';
import { site } from '../../data/site';
import Section from '../ui/Section.astro';
import SectionHead from '../ui/SectionHead.astro';
import Icon from '../ui/Icon.astro';
import Button from '../ui/Button.astro';

/**
 * Блок 13 из doc 03. Отдельных страниц под каждый район не делаем —
 * это переспам, поисковики за такое понижают.
 */
---

<Section soft labelledby="geo-title">
  <div class="geo">
    <div class="geo__text">
      <SectionHead
        eyebrow="География"
        title="Выезжаем по Екатеринбургу и области"
        highlight="и области"
        sub="Осмотр объекта бесплатный. По области — по согласованию, обычно в течение суток."
        id="geo-title"
      />

      <div class="geo__group" data-reveal>
        <h3 class="geo__sub">Районы Екатеринбурга</h3>
        <ul class="chip-row">
          {geography.districts.map((d) => <li><span class="chip">{d}</span></li>)}
        </ul>
      </div>

      <div class="geo__group" data-reveal>
        <h3 class="geo__sub">Города области</h3>
        <ul class="chip-row">
          {geography.cities.map((c) => <li><span class="chip">{c}</span></li>)}
        </ul>
      </div>

      <div class="geo__actions" data-reveal>
        <Button variant="primary" data-modal-open="lead">Вызвать специалиста на объект</Button>
        <Button href={site.phoneHref} variant="ghost" icon="phone">{site.phone}</Button>
      </div>
    </div>

    <aside class="geo__map" data-reveal>
      <!-- Карта-заглушка: подключить Яндекс.Карты после подтверждения адреса
           офиса (OPEN-QUESTIONS.md). Виджет грузим отложенно, при попадании
           в область видимости — требование ТЗ §4. -->
      <div class="geo__map-inner">
        <svg viewBox="0 0 400 320" aria-hidden="true" class="geo__grid">
          <defs>
            <pattern id="geo-grid" width="40" height="40" patternUnits="userSpaceOnUse">
              <path d="M40 0H0v40" fill="none" stroke="currentColor" stroke-width="1" />
            </pattern>
          </defs>
          <rect width="400" height="320" fill="url(#geo-grid)" />
        </svg>

        <span class="geo__pin geo__pin--main">
          <Icon name="pin" size={20} />
          <b>Екатеринбург</b>
        </span>
        <span class="geo__pin geo__pin--a">Верхняя Пышма</span>
        <span class="geo__pin geo__pin--b">Берёзовский</span>
        <span class="geo__pin geo__pin--c">Первоуральск</span>
        <span class="geo__pin geo__pin--d">Арамиль</span>
      </div>

      <p class="geo__note">
        <Icon name="clock" size={18} />
        Работаем {site.hours}. Ночные смены и выходные — по договору.
      </p>
    </aside>
  </div>
</Section>

<style>
  .geo {
    display: grid;
    grid-template-columns: 1fr 0.85fr;
    gap: clamp(1.5rem, 0.8rem + 3vw, 3.5rem);
    align-items: start;
  }

  .geo__group {
    margin-top: var(--sp-6);
  }

  .geo__sub {
    margin-bottom: var(--sp-3);
    font-size: var(--fs-caption);
    font-weight: 700;
    letter-spacing: var(--tracking-eyebrow);
    text-transform: uppercase;
    color: var(--ink-soft);
  }

  .geo__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-3);
    margin-top: var(--sp-7);
  }

  .geo__map-inner {
    position: relative;
    aspect-ratio: 5 / 4;
    overflow: hidden;
    border-radius: var(--r-xl);
    background: var(--white);
  }

  .geo__grid {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    color: var(--line);
  }

  .geo__pin {
    position: absolute;
    display: inline-flex;
    align-items: center;
    gap: var(--sp-2);
    padding: var(--sp-2) var(--sp-4);
    border-radius: var(--r-pill);
    background: var(--white);
    border: 1px solid var(--line);
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--ink-muted);
    white-space: nowrap;
    box-shadow: var(--shadow-sm);
  }

  .geo__pin--main {
    top: 44%;
    left: 50%;
    transform: translate(-50%, -50%);
    background: var(--blue);
    border-color: transparent;
    color: var(--white);
    font-size: var(--fs-caption);
    padding: var(--sp-3) var(--sp-5);
    box-shadow: var(--shadow-blue);
  }

  .geo__pin--a {
    top: 16%;
    left: 54%;
  }
  .geo__pin--b {
    top: 30%;
    right: 6%;
  }
  .geo__pin--c {
    bottom: 26%;
    left: 6%;
  }
  .geo__pin--d {
    bottom: 12%;
    right: 14%;
  }

  .geo__note {
    display: flex;
    align-items: center;
    gap: var(--sp-3);
    margin-top: var(--sp-4);
    font-size: var(--fs-caption);
    color: var(--ink-muted);
  }

  .geo__note svg {
    flex: none;
    color: var(--blue);
  }

  @media (max-width: 900px) {
    .geo {
      grid-template-columns: 1fr;
    }
  }
</style>
