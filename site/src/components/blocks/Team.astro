---
import { team } from '../../data/content';
import Section from '../ui/Section.astro';
import SectionHead from '../ui/SectionHead.astro';
import Picture from '../ui/Picture.astro';
import Squiggle from '../ui/Squiggle.astro';

/**
 * Блок 12 из doc 03. Doc 07: сток в этом блоке недопустим — его узнают,
 * и весь блок работает в минус. Поэтому подписи описывают роли, а не
 * выдуманных людей: заменить на реальные фото после фотосессии
 * (OPEN-QUESTIONS.md, вопрос 6.6).
 */
---

<Section labelledby="team-title">
  <SectionHead
    eyebrow="Кто приедет"
    title="Постоянный состав на объекте"
    highlight="на объекте"
    sub="Бригада не меняется от смены к смене — люди знают ваш объект, а не разбираются в нём заново каждый раз."
    id="team-title"
  />

  <div class="team" data-reveal>
    <ul class="team__list">
      {team.map((p) => (
        <li class="team__card" data-reveal-item>
          <Picture
            name={p.photo}
            alt={p.name}
            ratio="portrait"
            sizes="(max-width: 900px) 45vw, 20vw"
            class="team__photo"
          >
            <span class="media__cap">
              <span class="chip">{p.name}</span>
            </span>
          </Picture>
          <p class="team__role">{p.role}</p>
        </li>
      ))}
    </ul>

    <aside class="team__quote">
      <Squiggle color="blue" width={220} class="team__squiggle" />
      <blockquote>
        Чистота — это не разовая уборка, а процесс, который не сбивается
      </blockquote>
      <p>
        Чек-лист по каждой зоне, фотоотчёт после смены и один менеджер, который знает ваш объект.
        Замену выводим за 2 часа, замечания закрываем за сутки.
      </p>
    </aside>
  </div>
</Section>

<style>
  .team {
    display: grid;
    gap: var(--sp-5);
  }

  .team__list {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--sp-4);
  }

  .team__photo {
    border-radius: var(--r-lg);
  }

  .team__role {
    margin-top: var(--sp-3);
    font-size: var(--fs-caption);
    color: var(--ink-muted);
  }

  /* Крупная цитата с загогулиной — приём макета */
  .team__quote {
    position: relative;
    overflow: hidden;
    display: grid;
    grid-template-columns: 1.2fr 1fr;
    align-items: center;
    gap: var(--sp-6);
    padding: clamp(1.5rem, 0.9rem + 2.4vw, 3rem);
    border-radius: var(--r-xl);
    background: var(--surface);
  }

  .team__squiggle {
    right: 8%;
    top: 50%;
    transform: translateY(-50%);
    opacity: 0.18;
  }

  .team__quote blockquote {
    position: relative;
    z-index: 1;
    font-family: var(--font-display);
    font-size: var(--fs-h3);
    font-weight: 800;
    line-height: 1.2;
    letter-spacing: var(--tracking-tight);
  }

  .team__quote p {
    position: relative;
    z-index: 1;
    font-size: var(--fs-sm);
    color: var(--ink-muted);
  }

  @media (max-width: 900px) {
    .team__list {
      grid-template-columns: repeat(2, 1fr);
    }

    .team__quote {
      grid-template-columns: 1fr;
    }
  }
</style>
